# ── OmniSystem 本地配置（複製為 .env 後依需要調整）──
# cp .env.example .env

# 伺服器
HOST=0.0.0.0
PORT=3000

# 第 2 層記憶樞紐資料目錄
# 本機直跑（node server.js）→ ./data；docker compose 執行時由 compose 覆寫為 /data 永久卷
SSAS_DATA_DIR=./data

# Pipeline 每層的展示延遲（毫秒）— 控制 SSE 視覺化節奏
SSAS_PIPELINE_DELAY_MS=350

# 第 3 層推理模式：local（離線優先）；未來可選 groq
SSAS_REASONING_MODE=local

# 選填：第 3 層推理大腦的外部 LLM 金鑰（留空 = 離線本地模式，離線即可完整運行）
GROQ_API_KEY=
